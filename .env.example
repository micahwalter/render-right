# Required: Vercel AI Gateway API key (used for Google, Meta, OpenAI models)
# Get from: Vercel dashboard → AI Gateway → API Keys → Create key
AI_GATEWAY_API_KEY=your_key_here

# Required: Anthropic API key (used directly for Claude models, bypassing the gateway)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: GitHub personal access token
# Without this, GitHub allows 60 API requests/hour (unauthenticated).
# With it: 5,000/hour. Get one at https://github.com/settings/tokens
# No special scopes needed for public repos.
GITHUB_TOKEN=your_token_here

# Optional: Password to enable HTTP Basic Auth on the site (proxy.ts).
# Leave unset to disable auth.
SITE_PASSWORD=

# Optional: Override which models the eval harness tests (comma-separated gateway slugs).
# Default: anthropic/claude-haiku-4.5,google/gemini-2.5-flash,meta/llama-4-scout
# EVAL_MODELS=anthropic/claude-haiku-4.5,google/gemini-2.5-flash
